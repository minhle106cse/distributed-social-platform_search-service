# Service-only secrets for search-service.
#
# Only search-service's code reads these (ClaudeSummarizer/GeminiSummarizer —
# verified via grep, no other service references them). Kept out of the
# shared root .env so core-api/notification-service/auth-service/worker-service
# never load a paid API key they don't use — see .ai/memory/conventions.jsonl
# (2026-07-05, "env-centralization-tradeoff-analysis-and-env-example-rewrite").
#
# Copy to apps/search-service/.env.secrets (gitignored) and fill in real values.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# RS256 private key search-service signs its internal gRPC assertions with
# (→ core-api's MembershipVerification). base64-encoded PEM. Generate with:
#   bash scripts/gen-internal-keys.sh   (writes it here + the public key is derived + served at /.well-known/jwks.json)
INTERNAL_ASSERTION_PRIVATE_KEY=

# Moved here from the shared root .env — see
# .ai/plans/env-split-per-service.plan.md §2.5.
SEARCH_DATABASE_URL="postgresql://svc_search:<from scripts/gen-db-passwords.sh>@localhost:15432/search_db?schema=public"

# DUPLICATE, intentional — also lives in root .env.example (docker-compose
# boots ES with that copy). This copy is what search-service connects with.
# Drift between the two is caught by `npm run check` (check:env, Check 1).
ELASTIC_PASSWORD=changeme
